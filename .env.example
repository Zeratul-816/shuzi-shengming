# ─────────────────────────────────────────────────────────────
# 全部可省略：不填也能跑。
#   · 有 key（见下方「key 放哪」）→ 自动走真实模型
#   · 没 key                      → 自动用 mock 离线桩，不花钱
# 复制成 .env 才生效；也可以不建 .env，直接用环境变量或 key 文件。
# ─────────────────────────────────────────────────────────────

# ── key 放哪（任选其一，优先级从上到下）──────────────────────
# 1) 环境变量：DH_API_KEY=sk-xxxx
# 2) 本文件：  DH_API_KEY=sk-xxxx
# 3) 单独文件（推荐，不会误提交）。程序会自动找：
#      ~/.deepseek_api_key      ← 建议用这个
#      ~/.deepseek.key
#      ~/deepseek_api_key.txt
#      ~/api-key.txt
#      ~/.api-key
#    文件里只写 sk-xxxx 即可，也支持 DEEPSEEK_API_KEY=sk-xxxx 或 export 形式。
# 4) 指定路径：DH_API_KEY_FILE=D:\keys\ds.txt

# 留空 = 自动判断（有 key 走 openai 兼容，没 key 走 mock）
# DH_PROVIDER=mock | openai | anthropic
DH_PROVIDER=

# OpenAI 兼容端点。DeepSeek 用这个，其他见下方注释。
DH_BASE_URL=https://api.deepseek.com/v1
#   Kimi     https://api.moonshot.cn/v1
#   Qwen     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama   http://127.0.0.1:11434/v1

DH_API_KEY=

# 表达层：用最强的那个；编码层：用便宜快的。
# 建议不同厂商，避免模型自评自夸（开发期只有一把 key 时先用同一个）。
DH_EXPRESS_MODEL=deepseek-chat
DH_APPRAISE_MODEL=deepseek-chat

# v2 不再需要 embeddings 接口：检索走时间/人物/关键词/状态四路，没有向量。

# ── 其它 ─────────────────────────────────────────────────────
# 动机引擎一拍多少毫秒（默认 30000 = 30 秒）
DH_TICK_MS=30000
# 反刍通道：每轮多大比例会"突然想起"一件跟话题无关但当时重要的事（0 = 关）
DH_SERENDIPITY=0.12
# 人设目录（默认 persona/）。想做人设 A/B 就指向另一个目录
# DH_PERSONA_DIR=
# 记忆库所在目录（默认 data/）与库文件（默认 data/memory.db）
# DH_DATA_DIR=
# DH_DB_PATH=
# 每轮额外打印意图/情绪/召回通道/合规检查/耗时
# DH_DEBUG=1
